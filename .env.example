# Copy to .env and adjust.

# ImpactU API the tools call. The documented routes (help.impactu.colav.co) are on dev today;
# switch to https://api.impactu.colav.co once production serves the same routes.
IMPACTU_API_BASE=https://api.dev.impactu.colav.co

# Public host name(s) of this server, comma-separated. Requests with another Host header are refused
# (protection against DNS rebinding).
MCP_PUBLIC_HOSTS=mcp.impactu.colav.co

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=2
LOG_LEVEL=info

# API client: seconds per request, cache lifetime and size, simultaneous requests per worker
IMPACTU_TIMEOUT=90
IMPACTU_CACHE_TTL=600
IMPACTU_CACHE_SIZE=2000
IMPACTU_MAX_CONCURRENCY=8
